{
  "mcpServers": {
    "argocd-mcp": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/adityaraj178/mcp-argocd-py",
        "argocd-mcp",
        "stdio"
      ],
      "env": {
        "ARGOCD_INSECURE_SKIP_VERIFY": "true",
        "ARGOCD_BASE_URL": "<argocd_url>",
        "ARGOCD_API_TOKEN": "<argocd_token>"
      }
    }
  }
}
